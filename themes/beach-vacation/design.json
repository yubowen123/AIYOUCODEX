{
  "schemaVersion": 1,
  "id": "beach-vacation",
  "language": "海边度假：粉色晚霞、碧蓝海浪、奶油沙滩和七位度假角色",
  "radius": {
    "control": 18,
    "card": 16,
    "message": 16,
    "dialog": 20,
    "composer": 24,
    "shell": 16
  },
  "spacing": {
    "unit": 4,
    "stack": 10,
    "message-x": 14,
    "message-y": 12
  },
  "borders": {
    "width": 1,
    "focusWidth": 2
  },
  "typography": {
    "family": "system-ui, -apple-system, BlinkMacSystemFont, PingFang SC, sans-serif",
    "bodySizePolicy": "inherit-host",
    "bodyLineHeight": 1.65,
    "brand": "assets/wordmark.svg"
  },
  "elevation": {
    "message": "inset 0 1px 1px #ffffffee,0 3px 10px #9d536810",
    "card": "inset 0 1px 1px #ffffffee,0 2px 6px #9d536812,0 7px 18px #9d536812",
    "dialog": "inset 0 1px 1px #ffffffee,0 12px 32px #9d536829"
  },
  "motion": {
    "hoverMs": 140,
    "eventRateLimitMs": 900,
    "decorateOnly": true,
    "reducedMotion": "poster",
    "confirmedSendOnly": true
  },
  "content": {
    "messageTextOpacity": 1,
    "messageBackgroundAlpha": 0.97,
    "mediaOpacityMaximum": 0.9,
    "preserveMediaPixels": true
  },
  "invariants": [
    "no-business-action",
    "no-hit-interception",
    "no-structure-replacement",
    "default-theme-fallback"
  ]
}
