{
  "schemaVersion": 1,
  "id": "spongebob-beach-motion",
  "language": "深海碧蓝与浅海泡沫色，微光涟漪，简洁清爽",
  "radius": {
    "control": 18,
    "card": 16,
    "message": 16,
    "dialog": 20,
    "composer": 24,
    "shell": 16
  },
  "spacing": {
    "unit": 4,
    "stack": 10,
    "message-x": 14,
    "message-y": 12
  },
  "borders": {
    "width": 1,
    "focusWidth": 2
  },
  "typography": {
    "family": "system-ui, -apple-system, BlinkMacSystemFont, PingFang SC, sans-serif",
    "bodySizePolicy": "inherit-host",
    "bodyLineHeight": 1.65
  },
  "elevation": {
    "message": "inset 0 1px 1px #ffffffee,0 3px 10px #078da010",
    "card": "inset 0 1px 1px #ffffffee,0 2px 6px #078da012,0 7px 18px #078da012",
    "dialog": "inset 0 1px 1px #ffffffee,0 12px 32px #078da029"
  },
  "motion": {
    "hoverMs": 140,
    "eventRateLimitMs": 900,
    "decorateOnly": true,
    "reducedMotion": "poster",
    "confirmedSendOnly": true
  },
  "content": {
    "messageTextOpacity": 1,
    "messageBackgroundAlpha": 0.7568,
    "mediaOpacityMaximum": 0.48,
    "preserveMediaPixels": true
  },
  "invariants": [
    "no-business-action",
    "no-hit-interception",
    "no-structure-replacement",
    "default-theme-fallback"
  ]
}
