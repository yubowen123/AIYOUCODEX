{
  "schemaVersion": 1,
  "id": "mecha-control",
  "language": "金属控制舱：深石墨、钢蓝倒角、克制琥珀强调、透明圆角消息",
  "radius": {"control":9,"card":10,"message":16,"dialog":16,"composer":22,"shell":13},
  "spacing": {"unit":2,"stack":10,"message-x":14,"message-y":12},
  "borders": {"width":1,"focusWidth":2},
  "typography": {"family":"system-ui, -apple-system, BlinkMacSystemFont, PingFang SC, sans-serif","bodySizePolicy":"inherit-host","bodyLineHeight":1.5,"brand":"assets/wordmark.svg"},
  "elevation": {"message":"inset 0 1px 1px #d0e6ff18,0 3px 10px #0003","card":"inset 0 1px 1px #d0e6ff24,inset 0 -1px 2px #0008,0 2px 3px #0008,0 7px 18px #0005","dialog":"inset 0 1px 2px #d5edff45,0 14px 35px #0008"},
  "motion": {"hoverMs":120,"eventRateLimitMs":900,"decorateOnly":true,"reducedMotion":"poster","confirmedSendOnly":true},
  "content": {"messageTextOpacity":1,"messageBackgroundAlpha":0.82,"mediaOpacityMaximum":0.46,"preserveMediaPixels":true},
  "invariants": ["no-business-action","no-hit-interception","no-structure-replacement","default-theme-fallback"]
