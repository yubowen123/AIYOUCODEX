{
  "schemaVersion": 1,
  "id": "pink-candy",
  "language": "粉嫩软糖：连续云海、上部软糖兔、奶白曲面、淡玫粉细边、低密度柔光",
  "radius": {
    "control": 18,
    "card": 16,
    "message": 16,
    "dialog": 20,
    "composer": 24,
    "shell": 16
  },
  "spacing": {
    "unit": 4,
    "stack": 10,
    "message-x": 14,
    "message-y": 12
  },
  "borders": {
    "width": 1,
    "focusWidth": 2
  },
  "typography": {
    "family": "system-ui, -apple-system, BlinkMacSystemFont, PingFang SC, sans-serif",
    "bodySizePolicy": "inherit-host",
    "bodyLineHeight": 1.65,
    "brand": "assets/wordmark.svg"
  },
  "elevation": {
    "message": "inset 0 1px 1px #ffffffee,0 3px 10px #c2578610",
    "card": "inset 0 1px 1px #ffffffee,0 2px 6px #c2578612,0 7px 18px #c2578612",
    "dialog": "inset 0 1px 1px #ffffffee,0 12px 32px #c2578629"
  },
  "motion": {
    "hoverMs": 140,
    "eventRateLimitMs": 900,
    "decorateOnly": true,
    "reducedMotion": "poster",
    "confirmedSendOnly": true
  },
  "content": {
    "messageTextOpacity": 1,
    "messageBackgroundAlpha": 0.82,
    "mediaOpacityMaximum": 0.78,
    "preserveMediaPixels": true
  },
  "invariants": [
    "no-business-action",
    "no-hit-interception",
    "no-structure-replacement",
    "default-theme-fallback"
  ]
}
