{
  "schemaVersion": 1,
  "mode": "light",
  "primitives": {
    "cream-50": "#f7f1e7",
    "cream-75": "#efe6d7",
    "paper-25": "#fffaf1",
    "brown-800": "#413730",
    "brown-650": "#665b51",
    "sand-200": "#d8cbb9",
    "clay-700": "#9a5743",
    "clay-500": "#bc775d",
    "blue-700": "#315e77",
    "green-700": "#426749",
    "brick-700": "#9e3e3c",
    "blush-100": "#ead5c2",
    "blue-500": "#4b819d",
    "green-500": "#628264",
    "brick-500": "#bd5950",
    "white": "#ffffff"
  },
  "semantic": {
    "bg": "cream-50",
    "surface": "cream-75",
    "elevated": "paper-25",
    "text": "brown-800",
    "muted": "brown-650",
    "border": "sand-200",
    "accent": "clay-700",
    "running": "blue-700",
    "complete": "green-700",
    "error": "brick-700",
    "user-bg": "blush-100",
    "brand": "clay-500",
    "running-outline": "blue-500",
    "complete-outline": "green-500",
    "error-outline": "brick-500"
  },
  "pairs": [
    {
      "role": "body",
      "foreground": "text",
      "background": "bg",
      "minimum": 7
    },
    {
      "role": "panel-body",
      "foreground": "text",
      "background": "elevated",
      "minimum": 7
    },
    {
      "role": "secondary",
      "foreground": "muted",
      "background": "elevated",
      "minimum": 4.5
    },
    {
      "role": "placeholder",
      "foreground": "muted",
      "background": "elevated",
      "minimum": 4.5
    },
    {
      "role": "timestamp",
      "foreground": "muted",
      "background": "bg",
      "minimum": 4.5
    },
    {
      "role": "link",
      "foreground": "running",
      "background": "elevated",
      "minimum": 4.5
    },
    {
      "role": "success",
      "foreground": "complete",
      "background": "elevated",
      "minimum": 4.5
    },
    {
      "role": "error",
      "foreground": "error",
      "background": "elevated",
      "minimum": 4.5
    },
    {
      "role": "warning",
      "foreground": "accent",
      "background": "elevated",
      "minimum": 4.5
    },
    {
      "role": "user-message",
      "foreground": "text",
      "background": "user-bg",
      "minimum": 4.5,
      "translucent": true
    },
    {
      "role": "assistant-message",
      "foreground": "text",
      "background": "elevated",
      "minimum": 7,
      "translucent": true
    },
    {
      "role": "message-link",
      "foreground": "running",
      "background": "elevated",
      "minimum": 4.5,
      "translucent": true
    },
    {
      "role": "accent-button",
      "foreground": "elevated",
      "background": "accent",
      "minimum": 4.5
    },
    {
      "role": "error-button",
      "foreground": "elevated",
      "background": "error",
      "minimum": 4.5
    }
  ],
  "contexts": [
    "Codex",
    "Dot",
    "Claude",
    "menus",
    "inputs",
    "tool-results",
    "assets",
    "arena",
    "taskboard",
    "settings",
    "dialogs",
    "permissions",
    "notifications",
    "search",
    "skills",
    "mcp",
    "terminal",
    "diff",
    "media-controls"
  ],
  "dynamicBackground": {
    "textSurfaceMustBeOpaque": false,
    "textSurfaceAlpha": 0.9,
    "textOpacity": 1,
    "imageOpacityMaximum": 0.46
  },
  "states": {
    "running": "running-outline",
    "completed-unread": "complete-outline",
    "error": "error-outline",
    "read": "border"
  }
}
