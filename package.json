{
  "name": "aiyoucodex",
  "version": "1.4.0",
  "description": "AIYOUcodex is a local, reversible Codex workspace with enhanced conversation views, project Taskboard, Skills groups, and a multimedia asset library for macOS and Windows.",
  "license": "MIT",
  "homepage": "https://github.com/yubowen123/AIYOUCODEX#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yubowen123/AIYOUCODEX.git"
  },
  "keywords": [
    "aiyoucodex",
    "codex",
    "sidebar",
    "asset-library",
    "macos",
    "windows",
    "productivity"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "type": "module",
  "scripts": {
    "inspect": "node scripts/inspect-sidebar.mjs",
    "test": "node --test test/*.test.mjs",
    "test:taskboard": "node --test test/vendor-taskboard.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "inject": "node scripts/injector.mjs --port 9231 --watch",
    "runtime": "node scripts/runtime.mjs --port 9231 --watch",
    "verify:keepalive": "node scripts/verify-managed-shortcut-keepalive.mjs",
    "verify:install": "node --test test/install-config.test.mjs test/public-install.test.mjs test/windows-public-install.test.mjs"
  },
  "devDependencies": {
    "ws": "^8.21.3"
  }
}
