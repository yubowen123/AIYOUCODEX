{
  "name": "aiyoucodex-bundled",
  "interface": {
    "displayName": "AIYOUcodex 内置插件"
  },
  "plugins": [
    {
      "name": "moke-aigc",
      "source": {
        "source": "local",
        "path": "./moke-aigc"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    },
    {
      "name": "openchatcut",
      "source": {
        "source": "local",
        "path": "./openchatcut"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_USE"
      },
      "category": "Productivity"
    }
  ]
}
